{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://handshake.cn/hsp/0.2/claim-envelope.schema.json",
  "title": "HSP 0.2 Claim Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "purpose",
    "scene",
    "recipient_endpoint_id",
    "claims",
    "authorization_receipt"
  ],
  "properties": {
    "schema_version": { "const": "claim-envelope-0.2" },
    "envelope_id": { "type": "string", "pattern": "^cenv_[A-Za-z0-9_-]{1,120}$" },
    "purpose": { "$ref": "hsp-common.schema.json#/$defs/purpose" },
    "scene": { "$ref": "hsp-common.schema.json#/$defs/scene" },
    "recipient_endpoint_id": { "$ref": "hsp-common.schema.json#/$defs/entityId" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "hsp-common.schema.json#/$defs/claim" }
    },
    "authorization_receipt": { "$ref": "authorization-receipt.schema.json" }
  }
}
