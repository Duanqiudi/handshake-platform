{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://handshake.cn/hsp/0.2/hsp-common.schema.json",
  "title": "HSP 0.2 common definitions",
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 32
    },
    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "scene": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,256}={0,2}$"
        }
      }
    },
    "claimRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "include_min": { "type": "boolean" },
        "include_max": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "min": { "type": "number" } }, "required": ["min"] },
        { "properties": { "max": { "type": "number" } }, "required": ["max"] }
      ]
    },
    "claimValue": {
      "oneOf": [
        { "type": "string", "maxLength": 2000 },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/$defs/claimRange" }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "predicate",
        "value",
        "source_type",
        "confidence",
        "sensitivity",
        "purposes",
        "audiences",
        "valid_until"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^clm_[A-Za-z0-9_-]{1,120}$"
        },
        "predicate": { "$ref": "#/$defs/predicate" },
        "value": { "$ref": "#/$defs/claimValue" },
        "source_type": {
          "enum": ["owner_confirmed", "document_imported", "host_ai_summary", "inferred"]
        },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "confidence": { "enum": ["confirmed", "supported", "unverified", "disputed"] },
        "sensitivity": {
          "enum": ["public", "professional", "private", "sensitive", "prohibited"]
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/purpose" }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "valid_until": { "type": "string", "format": "date-time" },
        "owner_signature": { "type": "string", "minLength": 16, "maxLength": 512 }
      }
    },
    "handshakeStatus": {
      "enum": [
        "DRAFT",
        "READY",
        "DISCOVERING",
        "CANDIDATE_FOUND",
        "OWNER_AUTHORIZED",
        "SCREENING",
        "WAITING_OWNER",
        "CLARIFYING",
        "REJECTED",
        "PROPOSAL",
        "WAITING_DUAL_CONSENT",
        "NO_MATCH",
        "REVEALED",
        "INTRODUCED",
        "FEEDBACK_COMPLETE",
        "CANCELLED",
        "EXPIRED",
        "POLICY_BLOCKED",
        "FAILED",
        "DISPUTED"
      ]
    },
    "stopCode": {
      "enum": [
        "SUCCESS_PROPOSAL",
        "HARD_CONFLICT",
        "ENOUGH_INFO",
        "HUMAN_REQUIRED",
        "NEED_OWNER",
        "OWNER_DECLINED",
        "BUDGET_EXHAUSTED",
        "POLICY_BLOCKED",
        "TIMEOUT",
        "LOW_CONFIDENCE"
      ]
    }
  }
}
