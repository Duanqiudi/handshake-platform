{
  "name": "@handshake/product-sqlite-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite adapter for the Handshake V1 product snapshot port.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:dependencies": "pnpm --filter @handshake/product-application build && pnpm --filter @handshake/product-core build",
    "build": "pnpm build:dependencies && tsc -p tsconfig.json",
    "typecheck": "pnpm build:dependencies && tsc -p tsconfig.test.json",
    "test": "pnpm build:dependencies && vitest run"
  },
  "dependencies": {
    "@handshake/product-application": "workspace:*",
    "@handshake/product-core": "workspace:*"
  }
}
