# Platform API (safe local defaults)
HOST=127.0.0.1
PORT=3220
HANDSHAKE_PRODUCT_DB_PATH=./var/handshake-product.sqlite
HANDSHAKE_DEMO_MODE=false
# Leave empty for unrestricted local onboarding; set a value for invite-only use.
HANDSHAKE_INVITE_CODE=
# Comma-separated browser origins allowed during local development.
HANDSHAKE_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Member Web build/runtime selection.
# false/unset = real API without demo controls
# true        = real API with labelled synthetic reset/account switcher
# local       = browser-only in-memory fallback, no backend
VITE_API_BASE_URL=http://127.0.0.1:3220/v1
VITE_DEMO_MODE=false

# Local stdio MCP Adapter. Put a real owner token only in your untracked .env
# or MCP client secret settings; never commit it here.
HANDSHAKE_API_BASE_URL=http://127.0.0.1:3220
HANDSHAKE_OWNER_TOKEN=
HANDSHAKE_API_TIMEOUT_MS=10000
